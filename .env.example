# Local development: set DJANGO_DEBUG=1. Production: set it to 0.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,ddnsk.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://ddnsk.pythonanywhere.com
APP_BASE_URL=http://127.0.0.1:8000

# Production database. PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/dds_nk
DATABASE_URL=
DJANGO_ALLOW_SQLITE=true

DJANGO_TIME_ZONE=Africa/Kampala
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Email. Local development uses the console backend automatically.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DDS-NK THRIVE <no-reply@example.com>
